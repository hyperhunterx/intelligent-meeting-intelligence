# Copy this file to ".env" and fill in your real key.
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Any OpenRouter model id. Fast + strong at JSON extraction:
#   google/gemini-2.5-flash       (recommended default)
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-haiku
MODEL=google/gemini-2.5-flash

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DB_PATH=imies.db

# Email (SMTP) — to send the auto-generated action report.
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and paste the 16-char value below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=
